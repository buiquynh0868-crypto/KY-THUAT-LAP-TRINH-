#include <stdio.h>
#include <math.h>

/* run this program using the console pauser or add your own getch, system("pause") or input loop */

int main() {
	float a , b , c; 
	float tong , P , can2_a; 
	
	printf ("Nhap so thuc a: "); 
	scanf ("%f", &a); 
	printf ("Nhap so thuc b: "); 
	scanf ("%f", &b); 
	printf ("Nhap so thuc c: ");
	scanf ("%f", &c); 
	
	tong = a + b + c; 
	P = a* (b+c)*(b+c);
	
	printf ("\n a) Tong 3 so =%2f \n", tong); 
	printf ("b) Gia tri bieu thuc P =%f \n"); 
	if (a>=0) {
		can2_a = sqrt (a); 
		printf ("c) can bac 2 cua a =%f \n", can2_a ); 
	} else {
		printf ( "c) Khong tinh duoc can bac hai vi a < 0 \n"); 
	}
	 
	
	return 0;
}
