	p= &a; *p = 67; // con tro se di den dia chi cua a, va thay doi gia tri cua a tu 12 thanh 67  
	p=&b;  *p=36;  // tuong tu tren  
	
	printf ("Gia tri a la: %d \n", a,*p); // in ra gia tri cua a  
